{
  "type": {
    "font-stack": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter Variable",
          "Inter Fallback",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$description": "Inter (self-hosted variable font), its metric-matched fallback, then the platform UI stack."
      },
      "display": {
        "$value": [
          "Space Grotesk Variable",
          "Space Grotesk Fallback",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$description": "Space Grotesk (self-hosted variable font), its metric-matched fallback, then the platform UI stack."
      },
      "mono": {
        "$value": [
          "Fira Code Variable",
          "Fira Code Fallback",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ],
        "$description": "Fira Code (self-hosted variable font), its metric-matched fallback, then platform monospace fonts."
      }
    },
    "font-size": {
      "$type": "dimension",
      "xs": {
        "$value": {
          "value": 0.75,
          "unit": "rem"
        },
        "$description": "Font size xs (12px at the default root size)."
      },
      "sm": {
        "$value": {
          "value": 0.875,
          "unit": "rem"
        },
        "$description": "Font size sm (14px at the default root size)."
      },
      "md": {
        "$value": {
          "value": 1,
          "unit": "rem"
        },
        "$description": "Font size md (16px at the default root size)."
      },
      "lg": {
        "$value": {
          "value": 1.25,
          "unit": "rem"
        },
        "$description": "Font size lg (20px at the default root size)."
      },
      "xl": {
        "$value": {
          "value": 1.5,
          "unit": "rem"
        },
        "$description": "Font size xl (24px at the default root size)."
      },
      "2xl": {
        "$value": {
          "value": 2,
          "unit": "rem"
        },
        "$description": "Font size 2xl (32px at the default root size)."
      },
      "3xl": {
        "$value": {
          "value": 2.5,
          "unit": "rem"
        },
        "$description": "Font size 3xl (40px at the default root size)."
      },
      "4xl": {
        "$value": {
          "value": 3,
          "unit": "rem"
        },
        "$description": "Font size 4xl (48px at the default root size)."
      }
    },
    "font-weight": {
      "400": {
        "$value": 400,
        "$description": "Regular weight."
      },
      "600": {
        "$value": 600,
        "$description": "Semibold weight."
      },
      "700": {
        "$value": 700,
        "$description": "Bold weight."
      },
      "$type": "fontWeight"
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.2,
        "$description": "Tight line height for headings."
      },
      "normal": {
        "$value": 1.6,
        "$description": "Comfortable line height for running text."
      }
    },
    "letter-spacing": {
      "$type": "number",
      "$description": "Letter spacing in em, as numbers. The letter-spacing/em transform appends em (decision 0004 amendment).",
      "neg-2": {
        "$value": -0.02,
        "$description": "-0.02em."
      },
      "0": {
        "$value": 0,
        "$description": "0em."
      },
      "16": {
        "$value": 0.16,
        "$description": "0.16em."
      }
    },
    "line-length": {
      "$type": "number",
      "$description": "Line lengths in ch, as numbers. The line-length/ch transform appends ch (refinement R12.6).",
      "65": {
        "$value": 65,
        "$description": "65ch."
      }
    },
    "family": {
      "$type": "fontFamily",
      "body": {
        "$value": "{type.font-stack.sans}",
        "$description": "Font family for body and UI text."
      },
      "heading": {
        "$value": "{type.font-stack.display}",
        "$description": "Font family for headings."
      },
      "code": {
        "$value": "{type.font-stack.mono}",
        "$description": "Font family for code and token names."
      },
      "label": {
        "$value": "{type.font-stack.mono}",
        "$description": "Font family for small uppercase annotation labels and badges."
      }
    },
    "size": {
      "$type": "dimension",
      "small": {
        "$value": "{type.font-size.sm}",
        "$description": "Secondary text: captions, footers, metadata."
      },
      "body": {
        "$value": "{type.font-size.md}",
        "$description": "Default running text."
      },
      "lead": {
        "$value": "{type.font-size.lg}",
        "$description": "Introductory paragraph text."
      },
      "display": {
        "$value": "{type.font-size.4xl}",
        "$description": "Display text, such as a hero name."
      },
      "h1": {
        "$value": "{type.font-size.3xl}",
        "$description": "Page title (h1)."
      },
      "h2": {
        "$value": "{type.font-size.2xl}",
        "$description": "Section heading (h2)."
      },
      "h3": {
        "$value": "{type.font-size.xl}",
        "$description": "Subsection heading (h3)."
      },
      "h4": {
        "$value": "{type.font-size.lg}",
        "$description": "Minor heading (h4)."
      },
      "h5": {
        "$value": "{type.font-size.md}",
        "$description": "Minor heading (h5)."
      },
      "h6": {
        "$value": "{type.font-size.sm}",
        "$description": "Minor heading (h6)."
      },
      "label": {
        "$value": "{type.font-size.xs}",
        "$description": "Small uppercase annotation labels."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "body": {
        "$value": "{type.font-weight.400}",
        "$description": "Weight for running text."
      },
      "strong": {
        "$value": "{type.font-weight.600}",
        "$description": "Weight for emphasis and labels."
      },
      "heading": {
        "$value": "{type.font-weight.700}",
        "$description": "Weight for headings."
      }
    },
    "leading": {
      "$type": "number",
      "body": {
        "$value": "{type.line-height.normal}",
        "$description": "Line height for running text."
      },
      "heading": {
        "$value": "{type.line-height.tight}",
        "$description": "Line height for headings."
      }
    },
    "tracking": {
      "$type": "number",
      "display": {
        "$value": "{type.letter-spacing.neg-2}",
        "$description": "Letter spacing for large display headings."
      },
      "body": {
        "$value": "{type.letter-spacing.0}",
        "$description": "Letter spacing for running text."
      },
      "label": {
        "$value": "{type.letter-spacing.16}",
        "$description": "Letter spacing for small uppercase mono labels."
      }
    },
    "measure": {
      "$type": "number",
      "text": {
        "$value": "{type.line-length.65}",
        "$description": "Readable line length for running text (about 65 characters)."
      }
    }
  }
}
