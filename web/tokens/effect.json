{
  "effect": {
    "shadow": {
      "$type": "shadow",
      "none": {
        "$value": {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 0,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        "$description": "No shadow."
      },
      "sm": {
        "$value": {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 0.08,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 2,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        "$description": "Small shadow for light backgrounds."
      },
      "md": {
        "$value": {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 0.12,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 4,
            "unit": "px"
          },
          "blur": {
            "value": 12,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        "$description": "Medium shadow for light backgrounds."
      },
      "sm-dark": {
        "$value": {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 0.3,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 2,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        "$description": "Small shadow for dark backgrounds."
      },
      "md-dark": {
        "$value": {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 0.4,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 4,
            "unit": "px"
          },
          "blur": {
            "value": 12,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        "$description": "Medium shadow for dark backgrounds."
      }
    },
    "line": {
      "1": {
        "$value": {
          "value": 1,
          "unit": "px"
        },
        "$description": "1px line."
      },
      "2": {
        "$value": {
          "value": 2,
          "unit": "px"
        },
        "$description": "2px line."
      },
      "3": {
        "$value": {
          "value": 3,
          "unit": "px"
        },
        "$description": "3px line."
      },
      "$type": "dimension"
    },
    "blur-radius": {
      "$type": "dimension",
      "12": {
        "$value": {
          "value": 12,
          "unit": "px"
        },
        "$description": "12px blur radius."
      }
    },
    "focus-ring": {
      "$type": "dimension",
      "width": {
        "$value": "{effect.line.2}",
        "$description": "Focus indicator outline width."
      },
      "offset": {
        "$value": "{effect.line.2}",
        "$description": "Gap between an element and its focus indicator."
      }
    },
    "backdrop": {
      "$type": "dimension",
      "glass": {
        "$value": "{effect.blur-radius.12}",
        "$description": "Backdrop blur behind glass surfaces."
      }
    },
    "border": {
      "$type": "dimension",
      "width": {
        "$value": "{effect.line.2}",
        "$description": "Border width of controls and surfaces."
      },
      "width-thick": {
        "$value": "{effect.line.3}",
        "$description": "Width of a thick rule, such as a Separator's thick variant: heavier than a border."
      }
    },
    "grid": {
      "$type": "dimension",
      "width": {
        "$value": "{effect.line.1}",
        "$description": "Width of the decorative grid pattern's lines (Card showcase media, color-ramp checkerboard): kept faint, thinner than borders."
      }
    },
    "underline": {
      "$type": "dimension",
      "thickness": {
        "$value": "{effect.line.1}",
        "$description": "Thickness of link underlines."
      },
      "offset": {
        "$value": "{effect.line.2}",
        "$description": "Gap between link text and its underline."
      },
      "thickness-hover": {
        "$value": "{effect.line.2}",
        "$description": "Thickness of a hovered link underline."
      }
    }
  }
}
