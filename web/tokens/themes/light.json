{
  "color": {
    "$type": "color",
    "surface": {
      "base": {
        "$value": "{color.sand.50}",
        "$description": "Page background."
      },
      "raised": {
        "$value": "{color.gray.0}",
        "$description": "Background of raised areas: cards, menus, table headers."
      },
      "sunken": {
        "$value": "{color.sand.100}",
        "$description": "Background of recessed areas: code, wells, preview panels."
      },
      "glass": {
        "$value": "{color.overlay.sand-50-85}",
        "$description": "Translucent background for the sticky header and glass cards, over a varied backdrop (blurred). Only default and muted text, links, focus rings and controls whose boundary is contrast-checked against glass may sit on it.",
        "$extensions": {
          "personal-site.contrast-backdrop": [
            "color.surface.base",
            "color.surface.raised",
            "color.surface.sunken",
            "color.action.background"
          ]
        }
      },
      "inverse": {
        "$value": "{color.gray.900}",
        "$description": "Background of inverse bubbles, such as tooltips: the default text color, so the page reads inverted."
      },
      "code": {
        "$value": "{color.gray.50}",
        "$description": "Background of code samples (CodeBlock): a cool grey in light, near-black in dark, set apart from the other surfaces."
      }
    },
    "text": {
      "default": {
        "$value": "{color.gray.900}",
        "$description": "Primary text.",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.surface.base",
              "min": "text"
            },
            {
              "against": "color.surface.raised",
              "min": "text"
            },
            {
              "against": "color.surface.sunken",
              "min": "text"
            },
            {
              "against": "color.surface.glass",
              "min": "text"
            },
            {
              "against": "color.surface.code",
              "min": "text"
            },
            {
              "against": "color.accent.background",
              "min": "text"
            }
          ]
        }
      },
      "muted": {
        "$value": "{color.gray.700}",
        "$description": "Secondary text.",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.surface.base",
              "min": "text"
            },
            {
              "against": "color.surface.raised",
              "min": "text"
            },
            {
              "against": "color.surface.sunken",
              "min": "text"
            },
            {
              "against": "color.surface.glass",
              "min": "text"
            },
            {
              "against": "color.surface.code",
              "min": "text"
            }
          ]
        }
      },
      "subtle": {
        "$value": "{color.gray.600}",
        "$description": "Tertiary text, such as metadata. Still body text, so 4.5:1. Not allowed on glass.",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.surface.base",
              "min": "text"
            },
            {
              "against": "color.surface.raised",
              "min": "text"
            },
            {
              "against": "color.surface.sunken",
              "min": "text"
            },
            {
              "against": "color.surface.code",
              "min": "text"
            }
          ]
        }
      },
      "inverse": {
        "$value": "{color.sand.50}",
        "$description": "Text on the inverse surface.",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.surface.inverse",
              "min": "text"
            }
          ]
        }
      }
    },
    "link": {
      "default": {
        "$value": "{color.blue.700}",
        "$description": "Link text.",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.surface.base",
              "min": "text"
            },
            {
              "against": "color.surface.raised",
              "min": "text"
            },
            {
              "against": "color.surface.sunken",
              "min": "text"
            },
            {
              "against": "color.surface.glass",
              "min": "text"
            }
          ]
        }
      },
      "hover": {
        "$value": "{color.blue.850}",
        "$description": "Link text on hover.",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.surface.base",
              "min": "text"
            },
            {
              "against": "color.surface.raised",
              "min": "text"
            },
            {
              "against": "color.surface.sunken",
              "min": "text"
            },
            {
              "against": "color.surface.glass",
              "min": "text"
            }
          ]
        }
      },
      "visited": {
        "$value": "{color.violet.600}",
        "$description": "Text of a visited link, where a Link opts in with showVisited (violet).",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.surface.base",
              "min": "text"
            },
            {
              "against": "color.surface.raised",
              "min": "text"
            },
            {
              "against": "color.surface.sunken",
              "min": "text"
            },
            {
              "against": "color.surface.glass",
              "min": "text"
            }
          ]
        }
      }
    },
    "action": {
      "background": {
        "$value": "{color.blue.700}",
        "$description": "Fill of primary actions and current-state markers."
      },
      "background-hover": {
        "$value": "{color.blue.850}",
        "$description": "Fill of primary actions on hover."
      },
      "text": {
        "$value": "{color.sand.50}",
        "$description": "Text and icons on an action fill.",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.action.background",
              "min": "text"
            },
            {
              "against": "color.action.background-hover",
              "min": "text"
            }
          ]
        }
      }
    },
    "accent": {
      "text": {
        "$value": "{color.gold.700}",
        "$description": "Accent text: accent badges and label highlights.",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.accent.background",
              "min": "text"
            },
            {
              "against": "color.surface.base",
              "min": "text"
            },
            {
              "against": "color.surface.raised",
              "min": "text"
            },
            {
              "against": "color.surface.sunken",
              "min": "text"
            }
          ]
        }
      },
      "background": {
        "$value": "{color.gold.100}",
        "$description": "Accent fill behind accent text."
      },
      "border": {
        "$value": "{color.gold.500}",
        "$description": "Decorative accent outline. Not contrast-checked; never the only boundary of a control."
      }
    },
    "accent-2": {
      "text": {
        "$value": "{color.violet.600}",
        "$description": "Second-accent (violet) text, on surfaces and on accent-2.background.",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.accent-2.background",
              "min": "text"
            },
            {
              "against": "color.surface.base",
              "min": "text"
            },
            {
              "against": "color.surface.raised",
              "min": "text"
            },
            {
              "against": "color.surface.sunken",
              "min": "text"
            }
          ]
        }
      },
      "background": {
        "$value": "{color.violet.50}",
        "$description": "Subtle violet tint behind accent-2 text, such as badges and highlights."
      },
      "border": {
        "$value": "{color.violet.600}",
        "$description": "Boundary of a violet fill or tint (3:1).",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.surface.base",
              "min": "non-text"
            },
            {
              "against": "color.surface.raised",
              "min": "non-text"
            },
            {
              "against": "color.surface.sunken",
              "min": "non-text"
            }
          ]
        }
      },
      "fill": {
        "$value": "{color.violet.200}",
        "$description": "Solid violet fill: the pressed state of action.background (primary toggles). Its lightness is flipped against action.background (3:1), so it isn't a general-purpose violet button fill.",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.action.background",
              "min": "non-text"
            }
          ]
        }
      },
      "fill-hover": {
        "$value": "{color.violet.300}",
        "$description": "accent-2.fill on hover and while pressing."
      },
      "fill-text": {
        "$value": "{color.violet.800}",
        "$description": "Text and icons on accent-2.fill and accent-2.fill-hover.",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.accent-2.fill",
              "min": "text"
            },
            {
              "against": "color.accent-2.fill-hover",
              "min": "text"
            }
          ]
        }
      }
    },
    "error": {
      "text": {
        "$value": "{color.red.700}",
        "$description": "Error text. Never the only cue: the wording or an icon (with a text alternative) must convey the status on its own (WCAG 1.4.1).",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.error.background",
              "min": "text"
            },
            {
              "against": "color.surface.base",
              "min": "text"
            },
            {
              "against": "color.surface.raised",
              "min": "text"
            },
            {
              "against": "color.surface.sunken",
              "min": "text"
            },
            {
              "against": "color.surface.code",
              "min": "text"
            }
          ]
        }
      },
      "background": {
        "$value": "{color.red.50}",
        "$description": "Error tint behind error text. Never the only cue: the wording or an icon (with a text alternative) must convey the status on its own (WCAG 1.4.1)."
      },
      "border": {
        "$value": "{color.red.600}",
        "$description": "Error boundary (3:1). Never the only cue: the wording or an icon (with a text alternative) must convey the status on its own (WCAG 1.4.1).",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.surface.base",
              "min": "non-text"
            },
            {
              "against": "color.surface.raised",
              "min": "non-text"
            },
            {
              "against": "color.surface.sunken",
              "min": "non-text"
            }
          ]
        }
      }
    },
    "success": {
      "text": {
        "$value": "{color.green.700}",
        "$description": "Success text. Never the only cue: the wording or an icon (with a text alternative) must convey the status on its own (WCAG 1.4.1).",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.success.background",
              "min": "text"
            },
            {
              "against": "color.surface.base",
              "min": "text"
            },
            {
              "against": "color.surface.raised",
              "min": "text"
            },
            {
              "against": "color.surface.sunken",
              "min": "text"
            }
          ]
        }
      },
      "background": {
        "$value": "{color.green.50}",
        "$description": "Success tint behind success text. Never the only cue: the wording or an icon (with a text alternative) must convey the status on its own (WCAG 1.4.1)."
      },
      "border": {
        "$value": "{color.green.600}",
        "$description": "Success boundary (3:1). Never the only cue: the wording or an icon (with a text alternative) must convey the status on its own (WCAG 1.4.1).",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.surface.base",
              "min": "non-text"
            },
            {
              "against": "color.surface.raised",
              "min": "non-text"
            },
            {
              "against": "color.surface.sunken",
              "min": "non-text"
            }
          ]
        }
      }
    },
    "warning": {
      "text": {
        "$value": "{color.orange.700}",
        "$description": "Warning text. Never the only cue: the wording or an icon (with a text alternative) must convey the status on its own (WCAG 1.4.1).",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.warning.background",
              "min": "text"
            },
            {
              "against": "color.surface.base",
              "min": "text"
            },
            {
              "against": "color.surface.raised",
              "min": "text"
            },
            {
              "against": "color.surface.sunken",
              "min": "text"
            }
          ]
        }
      },
      "background": {
        "$value": "{color.orange.50}",
        "$description": "Warning tint behind warning text. Never the only cue: the wording or an icon (with a text alternative) must convey the status on its own (WCAG 1.4.1)."
      },
      "border": {
        "$value": "{color.orange.600}",
        "$description": "Warning boundary (3:1). Never the only cue: the wording or an icon (with a text alternative) must convey the status on its own (WCAG 1.4.1).",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.surface.base",
              "min": "non-text"
            },
            {
              "against": "color.surface.raised",
              "min": "non-text"
            },
            {
              "against": "color.surface.sunken",
              "min": "non-text"
            }
          ]
        }
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.sand.200}",
        "$description": "Decorative dividers only. Not contrast-checked; never the only boundary of a control."
      },
      "default": {
        "$value": "{color.gray.300}",
        "$description": "Decorative lines that must read on every surface, such as a Separator's subtle line: firmer than subtle, about 1.5–2:1. Not contrast-checked; never the only boundary of a control."
      },
      "strong": {
        "$value": "{color.gray.500}",
        "$description": "Boundaries of UI components (3:1).",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.surface.base",
              "min": "non-text"
            },
            {
              "against": "color.surface.raised",
              "min": "non-text"
            },
            {
              "against": "color.surface.sunken",
              "min": "non-text"
            }
          ]
        }
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.blue.700}",
        "$description": "Focus indicator color (3:1 against every surface it can sit on).",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.surface.base",
              "min": "non-text"
            },
            {
              "against": "color.surface.raised",
              "min": "non-text"
            },
            {
              "against": "color.surface.sunken",
              "min": "non-text"
            },
            {
              "against": "color.surface.glass",
              "min": "non-text"
            },
            {
              "against": "color.surface.code",
              "min": "non-text"
            }
          ]
        }
      }
    },
    "grid": {
      "line": {
        "$value": "{color.overlay.blue-700-8}",
        "$description": "Faint blueprint grid lines on the page backdrop. Decorative; not contrast-checked."
      }
    },
    "fill": {
      "scrim": {
        "$value": "{color.overlay.gray-950-40}",
        "$description": "Dims the page behind a modal dialog. Text never sits on it (the dialog surface does), so it has no contrast pairing."
      }
    }
  },
  "effect": {
    "elevation": {
      "$type": "shadow",
      "none": {
        "$value": "{effect.shadow.none}",
        "$description": "Flat surfaces: no shadow."
      },
      "raised": {
        "$value": "{effect.shadow.sm}",
        "$description": "Shadow for slightly raised surfaces."
      },
      "overlay": {
        "$value": "{effect.shadow.md}",
        "$description": "Shadow for overlays such as menus and dialogs."
      }
    }
  }
}
