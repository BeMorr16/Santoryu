{
  "component": {
    "visually-hidden": {
      "focusable": {
        "background": {
          "$value": "{color.surface.raised}",
          "$description": "Background while focused (the skip-link look).",
          "$type": "color"
        },
        "text": {
          "$value": "{color.text.default}",
          "$description": "Text while focused.",
          "$type": "color",
          "$extensions": {
            "personal-site.contrast": [
              {
                "against": "component.visually-hidden.focusable.background",
                "min": "text"
              }
            ]
          }
        },
        "padding": {
          "$value": "{space.inset.sm}",
          "$description": "Padding while focused.",
          "$type": "dimension"
        },
        "radius": {
          "$value": "{radius.control}",
          "$description": "Corner radius while focused.",
          "$type": "dimension"
        },
        "elevation": {
          "$value": "{effect.elevation.overlay}",
          "$description": "Shadow while focused, so it reads above the page.",
          "$type": "shadow"
        }
      }
    }
  }
}
