{
  "component": {
    "link": {
      "color": {
        "$value": "{color.link.default}",
        "$type": "color",
        "$description": "Inline link text.",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.surface.base",
              "min": "text"
            },
            {
              "against": "color.surface.raised",
              "min": "text"
            },
            {
              "against": "color.surface.sunken",
              "min": "text"
            },
            {
              "against": "color.surface.glass",
              "min": "text"
            }
          ]
        }
      },
      "color-hover": {
        "$value": "{color.link.hover}",
        "$type": "color",
        "$description": "Inline link text on hover.",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.surface.base",
              "min": "text"
            },
            {
              "against": "color.surface.raised",
              "min": "text"
            },
            {
              "against": "color.surface.sunken",
              "min": "text"
            },
            {
              "against": "color.surface.glass",
              "min": "text"
            }
          ]
        }
      },
      "color-current": {
        "$value": "{color.text.default}",
        "$type": "color",
        "$description": "Text of a link to the current page (aria-current).",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.surface.base",
              "min": "text"
            },
            {
              "against": "color.surface.raised",
              "min": "text"
            },
            {
              "against": "color.surface.sunken",
              "min": "text"
            },
            {
              "against": "color.surface.glass",
              "min": "text"
            }
          ]
        }
      },
      "underline-thickness": {
        "$value": "{effect.underline.thickness}",
        "$type": "dimension",
        "$description": "Underline thickness."
      },
      "underline-offset": {
        "$value": "{effect.underline.offset}",
        "$type": "dimension",
        "$description": "Gap between the text and its underline."
      },
      "font-weight-current": {
        "$value": "{type.weight.strong}",
        "$type": "fontWeight",
        "$description": "Weight of a link to the current page, so it's marked by more than color."
      }
    }
  }
}
