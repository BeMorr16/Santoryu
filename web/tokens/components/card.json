{
  "component": {
    "card": {
      "border-width": {
        "$value": "{effect.border.width}",
        "$type": "dimension",
        "$description": "Card outline width, in every variant."
      },
      "radius": {
        "$value": "{radius.surface}",
        "$type": "dimension",
        "$description": "Card corners."
      },
      "padding": {
        "$value": "{space.inset.lg}",
        "$type": "dimension",
        "$description": "Padding inside the card."
      },
      "gap": {
        "$value": "{space.stack.sm}",
        "$type": "dimension",
        "$description": "Space between the heading, body and footer."
      },
      "heading-color": {
        "$value": "{color.text.default}",
        "$type": "color",
        "$description": "Heading text.",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "component.card.raised.background",
              "min": "text"
            },
            {
              "against": "component.card.flat.background",
              "min": "text"
            },
            {
              "against": "component.card.raised.background-hover",
              "min": "text"
            },
            {
              "against": "component.card.outlined.background-hover",
              "min": "text"
            },
            {
              "against": "component.card.flat.background-hover",
              "min": "text"
            },
            {
              "against": "component.card.glass.background-opaque",
              "min": "text"
            },
            {
              "against": "color.surface.base",
              "min": "text"
            },
            {
              "against": "color.surface.raised",
              "min": "text"
            },
            {
              "against": "color.surface.sunken",
              "min": "text"
            },
            {
              "against": "color.surface.glass",
              "min": "text"
            }
          ]
        }
      },
      "body-color": {
        "$value": "{color.text.muted}",
        "$type": "color",
        "$description": "Body and footer text.",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "component.card.raised.background",
              "min": "text"
            },
            {
              "against": "component.card.flat.background",
              "min": "text"
            },
            {
              "against": "component.card.raised.background-hover",
              "min": "text"
            },
            {
              "against": "component.card.outlined.background-hover",
              "min": "text"
            },
            {
              "against": "component.card.flat.background-hover",
              "min": "text"
            },
            {
              "against": "component.card.glass.background-opaque",
              "min": "text"
            },
            {
              "against": "color.surface.base",
              "min": "text"
            },
            {
              "against": "color.surface.raised",
              "min": "text"
            },
            {
              "against": "color.surface.sunken",
              "min": "text"
            },
            {
              "against": "color.surface.glass",
              "min": "text"
            }
          ]
        }
      },
      "transition-duration": {
        "$value": "{motion.duration.fast}",
        "$type": "duration",
        "$description": "Duration of a link card's hover change (0ms under reduced motion)."
      },
      "transition-easing": {
        "$value": "{motion.easing.standard}",
        "$type": "cubicBezier",
        "$description": "Easing of a link card's hover change."
      },
      "raised": {
        "background": {
          "$value": "{color.surface.raised}",
          "$type": "color",
          "$description": "Raised card (the default) surface."
        },
        "border": {
          "$value": "{color.border.subtle}",
          "$type": "color",
          "$description": "Raised card (the default) outline."
        },
        "elevation": {
          "$value": "{effect.elevation.raised}",
          "$type": "shadow",
          "$description": "Raised card (the default) shadow."
        },
        "background-hover": {
          "$value": "{color.surface.sunken}",
          "$type": "color",
          "$description": "Raised card (the default) surface while its link is hovered."
        },
        "border-hover": {
          "$value": "{color.border.strong}",
          "$type": "color",
          "$description": "Raised card (the default) outline while its link is hovered."
        }
      },
      "outlined": {
        "background": {
          "$value": "{color.fill.none}",
          "$type": "color",
          "$description": "Outlined card surface."
        },
        "border": {
          "$value": "{color.border.strong}",
          "$type": "color",
          "$description": "Outlined card outline."
        },
        "elevation": {
          "$value": "{effect.elevation.none}",
          "$type": "shadow",
          "$description": "Outlined card shadow."
        },
        "background-hover": {
          "$value": "{color.surface.sunken}",
          "$type": "color",
          "$description": "Outlined card surface while its link is hovered."
        },
        "border-hover": {
          "$value": "{color.border.strong}",
          "$type": "color",
          "$description": "Outlined card outline while its link is hovered."
        }
      },
      "flat": {
        "background": {
          "$value": "{color.surface.sunken}",
          "$type": "color",
          "$description": "Flat card surface."
        },
        "border": {
          "$value": "{color.fill.none}",
          "$type": "color",
          "$description": "Flat card outline."
        },
        "elevation": {
          "$value": "{effect.elevation.none}",
          "$type": "shadow",
          "$description": "Flat card shadow."
        },
        "background-hover": {
          "$value": "{color.surface.sunken}",
          "$type": "color",
          "$description": "Flat card surface while its link is hovered."
        },
        "border-hover": {
          "$value": "{color.border.strong}",
          "$type": "color",
          "$description": "Flat card outline while its link is hovered."
        }
      },
      "glass": {
        "background": {
          "$value": "{color.surface.glass}",
          "$type": "color",
          "$description": "Glass card surface."
        },
        "border": {
          "$value": "{color.border.subtle}",
          "$type": "color",
          "$description": "Glass card outline."
        },
        "elevation": {
          "$value": "{effect.elevation.raised}",
          "$type": "shadow",
          "$description": "Glass card shadow."
        },
        "background-hover": {
          "$value": "{color.surface.glass}",
          "$type": "color",
          "$description": "Glass card surface while its link is hovered."
        },
        "border-hover": {
          "$value": "{color.border.strong}",
          "$type": "color",
          "$description": "Glass card outline while its link is hovered."
        },
        "backdrop-blur": {
          "$value": "{effect.backdrop.glass}",
          "$type": "dimension",
          "$description": "Blur behind a glass card."
        },
        "background-opaque": {
          "$value": "{color.surface.raised}",
          "$type": "color",
          "$description": "Glass card surface, at rest and on hover, under reduced transparency."
        }
      },
      "focus-ring-color": {
        "$value": "{color.focus.ring}",
        "$type": "color",
        "$description": "Focus indicator drawn around a link card while its link has focus.",
        "$extensions": {
          "personal-site.contrast": [
            {
              "against": "color.surface.base",
              "min": "non-text"
            },
            {
              "against": "color.surface.raised",
              "min": "non-text"
            },
            {
              "against": "color.surface.sunken",
              "min": "non-text"
            }
          ]
        }
      }
    }
  }
}
