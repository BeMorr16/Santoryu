{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run tokens && react-router dev",
    "build": "pnpm run tokens && react-router build",
    "preview": "vite preview",
    "typecheck": "pnpm run tokens && react-router typegen && tsc --noEmit",
    "tokens": "node scripts/build-tokens.ts && node scripts/build-hub-data.ts",
    "test": "vitest run --project dom --project node",
    "test:build": "vitest run --project build"
  },
  "dependencies": {
    "@fontsource-variable/fira-code": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "style-dictionary": "5.6.1",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
